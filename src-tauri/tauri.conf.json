{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDK IDE",
  "version": "0.2.0",
  "identifier": "com.idk.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "IDK IDE", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600, "decorations": true, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-eval'" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "publisher": "IDK Open Source",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI development environment",
    "windows": { "allowDowngrades": false, "wix": { "language": "en-US" }, "nsis": { "installMode": "currentUser", "compression": "lzma", "startMenuFolder": "IDK IDE", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MkM3QjdBRjc3MUEyNDgKUldSSW9uSDNlbnNzWmZ5RnFIdVArTVBoQkY3d0RTeTMwRjdGM3NsUlRVRmQzdWZNaWhWRjc2bUIK",
      "endpoints": ["https://github.com/r-winn/IDK-IDE/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
